# Copia este fichero a .env y rellena los valores.

# Puerto del servidor local (por defecto 8787)
PORT=8787

# URL de PostgreSQL (obligatoria): base de datos de la aplicación.
# Ejemplos: Neon, Amazon RDS, PostgreSQL local o Docker.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_base?sslmode=require

# Claves de proveedores LLM (opcionales). Sin claves se usa el proveedor
# "simulado", que genera correcciones deterministas sin red.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Directorio de datos locales: originales y páginas PNG (por defecto ./data)
# DATA_DIR=./data

# Desactiva la verificación TLS solo si tu PostgreSQL local no la soporta
# PG_SSL=false
