# Copia este fichero a .env y rellena las claves que tengas.
# La app funciona sin claves usando el proveedor "simulado" (offline).

# Puerto del servidor local (por defecto 8787)
PORT=8787

# Claves de proveedores LLM (opcionales)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Directorio de datos (por defecto ./data)
# DATA_DIR=./data
